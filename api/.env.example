# Copy to api/.env (or set in the shell). Do not commit real passwords.

# App URL used in reset emails (HashRouter)
PUBLIC_APP_URL=http://127.0.0.1:8000

# SMTP — when HOST + FROM are set, forgot-password sends mail and does not return the token
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# true = STARTTLS (typical 587). For port 465 set SMTP_USE_SSL=true and SMTP_USE_TLS=false
SMTP_USE_TLS=true
SMTP_USE_SSL=false
