# Copy to .env and adjust. Never commit .env.

# Prefer leaving this unset. The app then talks to:
#   same-hostname:8000 when UI is on :3000 (localhost OR any LAN IP)
#   same origin when UI is served from the API (production / :8000)
# Only set this if the API lives on a different machine:
# REACT_APP_API_URL=http://127.0.0.1:8000

# false = call real auth + grading API (requires uvicorn + model weights).
# true / unset = demo mode (no API).
REACT_APP_DEMO_MODE=false

# Phase 3 landing — optional Calendly / Google Calendar booking URL
# REACT_APP_CALENDLY_URL=https://calendly.com/your-link
# REACT_APP_CONTACT_EMAIL=hello@cnelindia.com
