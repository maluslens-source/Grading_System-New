APP_NAME="Apple Grading API"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8080

APP_LOCALE=en
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_CONNECTION=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=apple_grading
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=10080

SANCTUM_STATEFUL_DOMAINS=localhost,127.0.0.1

# Python ML service (ONLY apple good/bad grading)
PYTHON_ML_URL=http://127.0.0.1:8000
PYTHON_ML_GRADE_PATH=/api/v1/grade
PYTHON_ML_TIMEOUT=300

# Auth
AUTH_TOKEN_DAYS=7
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=Admin123!
BOOTSTRAP_ADMIN_NAME="System Admin"

FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
